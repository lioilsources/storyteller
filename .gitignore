# Go
/bin/
*.exe
*.test

# Fetched/derived corpus data — large, regenerable, not meant for git.
# Keep the directory structure via .gitkeep; ignore its contents.
/corpus/data/raw/*/
/corpus/data/motifs/*/

# Flutter/Dart (app/ and any package under app/packages/)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
/app/build/
/app/ios/Pods/
/app/**/*.g.dart

# Env / local secrets
.env
.env.local
infra/*.local.yml

# OS cruft
.DS_Store
