# Go
/bin/
*.exe
*.test

# Fetched/derived corpus data — large, regenerable, not meant for git.
# Keep the directory structure via .gitkeep; ignore its contents.
/corpus/data/raw/*/
/corpus/data/motifs/*/

# Flutter/Dart (app/ and any package under app/packages/)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
/app/build/
/app/ios/Pods/
/app/**/*.g.dart

# Python (rag/ only — see rag/README.md)
rag/.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# rag pipeline outputs — large, regenerable
rag/data/*.jsonl
rag/data/packs/

# Env / local secrets
.env
.env.local
infra/*.local.yml

# Android signing — never commit. `.github/workflows/release-android.yml` writes
# both of these in CI from the ANDROID_KEYSTORE_* secrets; the real upload
# keystore lives in Distribution/Android/Storyteller/upload-keystore.jks.
# (app/android/.gitignore already covers these for that subtree; repeated here
# so a keystore dropped anywhere else in the repo is ignored too.)
key.properties
*.jks
*.keystore

# App Store Connect API key, if one is ever staged locally
AuthKey_*.p8

# OS cruft
.DS_Store

# RAG model files for the app — too big for git (GitHub rejects >100 MB).
# Built by rag/ (ONNX export of intfloat/multilingual-e5-small), copied in
# before a local build; see app/README.md "RAG na zařízení".
app/assets/rag/*.onnx
app/assets/rag/e5_tokenizer.json
# RAG packs from rag.build_pack — tens of MB and rebuilt as the pipeline
# runs; copied in for a local build like the model.
app/assets/rag/packs/*.db
rag/data/motif_images/
rag/data/scene_images/
rag/data/motif_cards.json
rag/data/scene_cards.json
rag/data/sounds/

# Pixar varianta karet (render-motifs -style pixar-3d), jako motif_images
rag/data/pixar-v1/
