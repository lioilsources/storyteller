# Go
/bin/
*.exe
*.test

# Fetched/derived corpus data — large, regenerable, not meant for git.
# Keep the directory structure via .gitkeep; ignore its contents.
/corpus/data/raw/*/
/corpus/data/motifs/*/

# Flutter/Dart (app/ and any package under app/packages/)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
/app/build/
/app/ios/Pods/
/app/**/*.g.dart

# Python (rag/ only — see rag/README.md)
rag/.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# rag pipeline outputs — large, regenerable
rag/data/*.jsonl
rag/data/packs/

# Env / local secrets
.env
.env.local
infra/*.local.yml

# Android signing — never commit. `.github/workflows/release-android.yml` writes
# both of these in CI from the ANDROID_KEYSTORE_* secrets; the real upload
# keystore lives in Distribution/Android/Storyteller/upload-keystore.jks.
# (app/android/.gitignore already covers these for that subtree; repeated here
# so a keystore dropped anywhere else in the repo is ignored too.)
key.properties
*.jks
*.keystore

# App Store Connect API key, if one is ever staged locally
AuthKey_*.p8

# OS cruft
.DS_Store
