{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" },
    "inputs": { "unet_name": "flux1-dev.safetensors", "weight_dtype": "fp8_e4m3fn" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "DualCLIPLoader" },
    "inputs": { "clip_name1": "clip_l.safetensors", "clip_name2": "t5xxl_fp16.safetensors", "type": "flux", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "IN_PROMPT" },
    "inputs": { "text": "placeholder prompt", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "IN_NEGATIVE" },
    "inputs": { "text": "", "clip": ["2", 0] }
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "IN_LATENT" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "7": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "FluxGuidance" },
    "inputs": { "conditioning": ["4", 0], "guidance": 3.5 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "IN_SEED" },
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["7", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "filename_prefix": "storyteller", "images": ["9", 0] }
  }
}
